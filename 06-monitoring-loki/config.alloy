local.file_match "sample_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/sample/*.log",
      "job"      = "sample-app",
    },
  ]
}

loki.source.file "sample_logs" {
  targets    = local.file_match.sample_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
